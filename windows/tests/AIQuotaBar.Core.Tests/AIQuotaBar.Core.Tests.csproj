<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core 层 xUnit 测试项目。
       公共属性（net8.0、Nullable、TreatWarningsAsErrors 等）继承自 windows/Directory.Build.props。
       测试命名与 Swift 端 AIQuotaBar/Tests/ 一一对应；fixtures 约定见 windows/docs/coding-conventions.md。 -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIQuotaBar.Core\AIQuotaBar.Core.csproj" />
  </ItemGroup>

</Project>
