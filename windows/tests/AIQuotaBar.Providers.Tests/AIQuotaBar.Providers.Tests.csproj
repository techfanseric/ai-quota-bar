<Project Sdk="Microsoft.NET.Sdk">

  <!-- Providers 层 xUnit 测试项目。
       公共属性（net8.0、Nullable、TreatWarningsAsErrors 等）继承自 windows/Directory.Build.props。
       所有 API 响应解析测试必须使用 windows/contracts/fixtures/ 样本，禁止自造 JSON。 -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers\AIQuotaBar.Providers.csproj" />
  </ItemGroup>

</Project>
