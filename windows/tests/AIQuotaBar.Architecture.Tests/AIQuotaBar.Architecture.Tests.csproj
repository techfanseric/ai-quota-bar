<Project Sdk="Microsoft.NET.Sdk">

  <!-- 架构依赖门禁（分层铁律的可执行形式，windows/docs/coding-conventions.md §4 TODO 与
       移植计划 §7）。用 NetArchTest（Mono.Cecil 只读程序集元数据）对 Core / Providers /
       Platform 三个被保护程序集做类型级依赖检查，每个规则一个 [Fact]，进 sln 即进 CI。
       TFM 覆盖为 net8.0-windows：被测的 AIQuotaBar.Platform 是 net8.0-windows
       （参照 AIQuotaBar.Platform.Tests 先例），纯 net8.0 测试项目无法引用它。
       不引用 App / Cli 工程：违规方向只能是 Core/Providers/Platform → App/Cli，
       违规引用会以类型引用名（AIQuotaBar.App / AIQuotaBar.Cli 命名空间）出现在被保护
       程序集元数据中，无需加载 App（AssemblyName=AIQuotaBar）/Cli 本体即可检出。 -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" PrivateAssets="all" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIQuotaBar.Core\AIQuotaBar.Core.csproj" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Providers\AIQuotaBar.Providers.csproj" />
    <ProjectReference Include="..\..\src\AIQuotaBar.Platform\AIQuotaBar.Platform.csproj" />
  </ItemGroup>

</Project>
