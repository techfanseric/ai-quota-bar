<Application x:Class="AIQuotaBar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- 颜色/字体/度量全部收敛进主题字典（Panels/Themes/Light.xaml|Dark.xaml，键位两本一致），
         本文件不持有任何颜色定义；ThemeService 运行时整本互换 MergedDictionaries[0]——
         该位置固定为主题字典位（SwapThemeDictionary 按索引 0 替换，勿在前插入其他字典）。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Panels/Themes/Dark.xaml" />
                <ResourceDictionary Source="Panels/PanelButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
