<panels:PopupWindow x:Class="AIQuotaBar.App.Panels.RoutePanel"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:panels="clr-namespace:AIQuotaBar.App.Panels"
                    Title="AI Quota Bar — 路由"
                    SizeToContent="Height"
                    Width="340">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Margin="8" Padding="0,4">
        <StackPanel>
            <DockPanel Margin="16,10,16,6">
                <TextBlock Text="Clash 路由" Foreground="{DynamicResource TextPrimary}"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="GroupText" Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </DockPanel>
            <Separator Background="#22FFFFFF" Height="1" Margin="10,2" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentRed}" FontSize="11"
                       TextWrapping="Wrap" Margin="16,8" Visibility="Collapsed" />
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="4,4">
                <StackPanel x:Name="RoutesHost" />
            </ScrollViewer>
            <Separator Background="#22FFFFFF" Height="1" Margin="10,4" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
                <Button x:Name="TestButton" Content="测速" Style="{StaticResource PanelButton}" Click="OnTest" />
                <Button x:Name="ReloadButton" Content="刷新" Style="{StaticResource PanelButton}" Click="OnReload" />
            </StackPanel>
        </StackPanel>
    </Border>
</panels:PopupWindow>
