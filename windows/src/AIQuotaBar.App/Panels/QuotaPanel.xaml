<panels:PopupWindow x:Class="AIQuotaBar.App.Panels.QuotaPanel"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:panels="clr-namespace:AIQuotaBar.App.Panels"
                    Title="AI Quota Bar — 配额概览"
                    SizeToContent="Height"
                    Width="380"
                    FontFamily="{DynamicResource PanelFontFamily}">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="8" Padding="0">
        <StackPanel>
            <Grid Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Foreground="{DynamicResource TextPrimary}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="AI Quota Bar" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock x:Name="UpdatedText" Grid.Column="1"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>

            <!-- 扁平 provider 列表：用对齐和分隔线建立层级，避免网页式重复卡片。 -->
            <StackPanel x:Name="ProvidersHost" />

            <Grid Background="{DynamicResource CommandBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHint"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="10.5" VerticalAlignment="Center" Margin="16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8">
                    <Button x:Name="RefreshButton" Style="{StaticResource CommandBarButton}"
                            Click="OnRefresh" />
                    <Button x:Name="RoutesButton" Style="{StaticResource CommandBarButton}" Click="OnRoutes" />
                    <Button x:Name="SettingsButton" Style="{StaticResource CommandBarButton}"
                            Click="OnSettings" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</panels:PopupWindow>
