<panels:PopupWindow x:Class="AIQuotaBar.App.Panels.QuotaPanel"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:panels="clr-namespace:AIQuotaBar.App.Panels"
                    Title="AI Quota Bar — 控制中心"
                    SizeToContent="Height"
                    Width="340">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Margin="8" Padding="0,4">
        <StackPanel>
            <TextBlock Text="AI Quota Bar"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="15" FontWeight="SemiBold"
                       Margin="16,10,16,6" />
            <Separator Background="#22FFFFFF" Height="1" Margin="10,2" />
            <StackPanel x:Name="ProvidersHost" Margin="4,6,4,2" />
            <Separator Background="#22FFFFFF" Height="1" Margin="10,4" />
            <DockPanel Margin="12,8">
                <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="刷新" Click="OnRefresh" />
                    <Button x:Name="SettingsButton" Content="设置" Click="OnSettings" />
                    <Button x:Name="ExitButton" Content="退出" Click="OnExit" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</panels:PopupWindow>
