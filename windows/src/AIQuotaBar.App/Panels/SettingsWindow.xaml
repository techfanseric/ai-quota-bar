<Window x:Class="AIQuotaBar.App.Panels.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Quota Bar — 设置" Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource PanelFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- 全部可见文案由 code-behind ApplyStrings 按当前语言填充（AppStrings 唯一来源，
         XAML 内文本仅为设计器占位）。主题/语言三选：即时生效，保存按钮统一落盘。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 主题三选（规格 §3）：即时生效（ThemeService.ApplyPreference），保存按钮落 AppSettings.Theme。 -->
            <TextBlock x:Name="ThemeLabel" Foreground="{DynamicResource TextPrimary}" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeFollowRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnThemePreferenceChecked" />
                <RadioButton x:Name="ThemeLightRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnThemePreferenceChecked" />
                <RadioButton x:Name="ThemeDarkRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnThemePreferenceChecked" />
            </StackPanel>

            <!-- 语言三选（对齐主题三选形态）：即时生效（LanguageService.ApplyPreference），保存按钮落 AppSettings.Language。 -->
            <TextBlock x:Name="LanguageLabel" Foreground="{DynamicResource TextPrimary}" FontSize="15"
                       FontWeight="SemiBold" Margin="0,14,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LangFollowRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnLanguagePreferenceChecked" />
                <RadioButton x:Name="LangChineseRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnLanguagePreferenceChecked" />
                <RadioButton x:Name="LangEnglishRadio"
                             Style="{StaticResource PanelRadioButton}" Checked="OnLanguagePreferenceChecked" />
            </StackPanel>

            <TextBlock x:Name="CredentialsSectionLabel" Foreground="{DynamicResource TextPrimary}" FontSize="15"
                       FontWeight="SemiBold" Margin="0,14,0,4" />
            <TextBlock x:Name="CredentialsHint" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="GlmCredentialLabel" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,8,0,4" />
                <TextBox x:Name="GlmBox" Height="60" TextWrapping="Wrap" AcceptsReturn="False"
                         Style="{StaticResource PanelTextBox}"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock x:Name="MinimaxTokenLabel" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,12,0,4" />
                <PasswordBox x:Name="MinimaxBox" Height="30" Style="{StaticResource PanelPasswordBox}" />

                <TextBlock x:Name="ProxyLabel" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="ProxyBox" Height="30" Style="{StaticResource PanelTextBox}" />

                <TextBlock x:Name="RefreshIntervalLabel" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="RefreshBox" Height="30" Style="{StaticResource PanelTextBox}"
                         PreviewTextInput="OnNumericOnly" />

                <CheckBox x:Name="AutostartCheck" Margin="0,16,0,0"
                          Style="{StaticResource PanelCheckBox}" />

                <TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentGreen}" FontSize="11"
                           Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Style="{StaticResource PanelButton}" Click="OnSave" MinWidth="72" />
            <Button x:Name="CloseButton" Style="{StaticResource PanelButton}" Click="OnClose" MinWidth="72" />
        </StackPanel>
    </Grid>
</Window>
