<!-- Swift 来源：无（Windows 端新增；亮/暗双主题字典 —— 暗色，保持 W2 已有视觉基线）。
     键位清单与 Light.xaml 严格一致（ThemeService 运行时整本互换，缺键即破相）：
       面板层：PanelBackground / PanelBorder / WindowBackgroundBrush
       文字层：TextPrimary / TextSecondary
       状态色：AccentGreen / AccentYellow / AccentRed / AccentBlue（兼容键）
       强调色：AccentBrush / AccentHoverBrush（运行时被 ThemeService 以 DWM ColorizationColor 覆盖，
               此处仅兜底默认值）
       容器层：ChartTrackBrush / SeparatorBrush / HoverBrush / CommandBarBrush
       输入层：InputBackgroundBrush / InputBorderBrush
       徽章层：BadgeGreenBrush / BadgeYellowBrush / BadgeRedBrush / BadgeMutedBrush（半透明衬底）
       字体度量：PanelFontFamily
       图表度量：GaugeStrokeThickness / UsageBarHeight（sys:Double，供 QuotaGauge/UsageBar 取） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:Double x:Key="GaugeStrokeThickness">4.5</sys:Double>
    <sys:Double x:Key="UsageBarHeight">6</sys:Double>

    <FontFamily x:Key="PanelFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- 弹层（亚克力之上）与不透明设置窗分别取 PanelBackground / WindowBackgroundBrush。 -->
    <SolidColorBrush x:Key="PanelBackground" Color="#F0202020" />
    <SolidColorBrush x:Key="PanelBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0" />

    <!-- 分档与 RingIconFactory 托盘环同规则（>50 绿 / >20 黄 / 其余红）。 -->
    <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50" />
    <SolidColorBrush x:Key="AccentYellow" Color="#F5B428" />
    <SolidColorBrush x:Key="AccentRed" Color="#DC3C3C" />
    <SolidColorBrush x:Key="AccentBlue" Color="#4C9EE8" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4C9EE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FB4F0" />

    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="CommandBarBrush" Color="#12FFFFFF" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#40FFFFFF" />

    <SolidColorBrush x:Key="BadgeGreenBrush" Color="#264CAF50" />
    <SolidColorBrush x:Key="BadgeYellowBrush" Color="#26F5B428" />
    <SolidColorBrush x:Key="BadgeRedBrush" Color="#26DC3C3C" />
    <SolidColorBrush x:Key="BadgeMutedBrush" Color="#22A8A8B0" />
</ResourceDictionary>
