<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 覆盖 windows/Directory.Build.props 的默认 TFM（net8.0）：
         本项目承载 Win32 / 桌面 API（托盘、DPAPI/CredMan、ConPTY、Toast 等），
         仅可在 Windows 上构建与运行——CI 使用 windows-latest runner（.github/workflows/windows-ci.yml），
         macOS 本机不要构建本项目（其余 net8.0 项目不受此限制，仍可跨平台测试）。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIQuotaBar.Core\AIQuotaBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kimi Desktop（Chromium/Electron）Cookies 库只读访问：Credentials/KimiDesktopCookieStore.cs。
         8.0.31 = 8.x 最新稳定（与 Platform.Tests 对齐）；该元包自带 Microsoft.Data.Sqlite.Core
         + SQLitePCLRaw.bundle_e_sqlite3（含 win-x64 原生 e_sqlite3，NuGet 还原需代理）。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>

</Project>
