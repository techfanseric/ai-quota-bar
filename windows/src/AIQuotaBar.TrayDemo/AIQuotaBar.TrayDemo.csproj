<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Phase 0 spike S6（计划 §9）：托盘 + 弹层可行性验证 demo。
         技术路线按计划 §6：Shell_NotifyIcon 直调（P/Invoke），不用实验性 TrayIcon API，不用 H.NotifyIcon。
         UseWindowsForms 仅为引用 System.Drawing（GDI+ 画环形图标），demo 本体不使用 WinForms 控件。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AIQuotaBar.TrayDemo</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
