<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Windows 端全部项目的公共构建属性。
    本文件位于 windows/ 根目录，自动应用于其下所有 csproj（Directory.Build.props 机制）。
    注意：AIQuotaBar.Platform 因需要 Win32 / 托盘 / 桌面 API，在其自身 csproj 中单独将
    TargetFramework 覆盖为 net8.0-windows，见 src/AIQuotaBar.Platform/AIQuotaBar.Platform.csproj。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
