#!/bin/sh
#
# postinstall — bring the app back if it was running, then delete the
# installer that was just consumed.
#
# Neither can happen inline. The app has to be relaunched inside the console
# user's session, and this script cannot delete the package it is being run
# from while Installer still holds it open. Both are handed to a one-shot
# launchd job that fires a few seconds after Installer releases the package.
#
# Arguments (per Apple's installer scripting guide):
#   $1 package path  $2 target location  $3 target volume  $4 root volume
# Environment: $SCRIPT_NAME $PACKAGE_PATH $INSTALLER_TEMP $RECEIPT_PATH

APP_NAME="AIQuotaBar"
APP_PATH="/Applications/AIQuotaBar.app"
# The release asset name. Deleting "the installer" means exactly this file —
# never a glob, so an unrelated package in the same folder is left alone.
INSTALLER_NAME="AIQuotaBar.pkg"

RELAUNCH_FLAG="/private/var/tmp/aiquotabar-installer-relaunch"
RELAUNCH_MAX_AGE=600
CLEANUP_DIR="/private/var/tmp"
CLEANUP_SCRIPT="$CLEANUP_DIR/aiquotabar-installer-cleanup.sh"
CLEANUP_PLIST="/Library/LaunchDaemons/com.techfanseric.aiquotabar.installer-cleanup.plist"
CLEANUP_LABEL="com.techfanseric.aiquotabar.installer-cleanup"
PENDING_RECORD="$CLEANUP_DIR/aiquotabar-installer-pending"

echo "$SCRIPT_NAME: installed $APP_NAME to $2"

console_user=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null)
# Everything below feeds this into `eval` and `sudo -u` as root. macOS account
# names are restricted to this character set; refuse anything else outright
# rather than relying on that being enforced upstream.
case "$console_user" in
    "" | *[!A-Za-z0-9._-]*) console_user="" ;;
esac
console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || echo "")

# Relaunch, but only if this install wrote the flag (a stale flag from an
# aborted install must not launch the app hours later), and only if the app
# was actually running before.
relaunch_app() {
    [ -n "$console_uid" ] || return 0
    [ -d "$APP_PATH" ] || return 0
    [ -f "$RELAUNCH_FLAG" ] || return 0

    now=$(/bin/date +%s)
    flagged=$(/usr/bin/stat -f "%m" "$RELAUNCH_FLAG" 2>/dev/null || echo 0)
    age=$((now - flagged))
    if [ "$age" -lt 0 ] || [ "$age" -gt "$RELAUNCH_MAX_AGE" ]; then
        echo "$SCRIPT_NAME: ignoring stale relaunch flag (${age}s old)"
        return 0
    fi

    echo "$SCRIPT_NAME: relaunching $APP_NAME for $console_user"
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" \
        /usr/bin/open "$APP_PATH" >/dev/null 2>&1 || \
        echo "$SCRIPT_NAME: relaunch failed, open $APP_NAME from the Dock" >&2
}

relaunch_app
/bin/rm -f "$RELAUNCH_FLAG"

# Which package files to delete once the install is done:
#   - the package Installer was handed, which is the user's original file when
#     installed from a terminal and a throwaway copy when opened in Finder
#   - the release asset in the console user's Downloads, which is the copy the
#     user actually opened when double-clicking
package_target() {
    candidate="$1"
    [ -n "$candidate" ] || return 1
    [ -f "$candidate" ] || return 1
    # An empty match arm falls through to the printf; returning here instead
    # would exit the function before it printed anything.
    case "$(/usr/bin/basename "$candidate")" in
        "$INSTALLER_NAME" | "$INSTALLER_NAME".*) ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$candidate"
}

# Absolute home: installer scripts run with / as the working directory, so
# "$user/Downloads" would resolve to /Downloads and never match.
#
# Do not rely on `dscl` here. Installer runs its scripts through PackageKit in a
# sandboxed context where the directory service lookup can fail, and the empty
# result would silently skip the Downloads copy. Tilde expansion needs the same
# lookup, so it is only the first of two tries: /Users/<name> is the standard
# location and needs nothing at all.
console_home=""
if [ -n "$console_user" ]; then
    eval "console_tilde=\"~${console_user}\""
    [ -d "$console_tilde" ] && console_home="$console_tilde"
    [ -n "$console_home" ] || [ ! -d "/Users/$console_user" ] || console_home="/Users/$console_user"
fi

handled_package=$(package_target "$1")
handled_downloads=""
if [ -n "$console_home" ]; then
    handled_downloads=$(package_target "$console_home/Downloads/$INSTALLER_NAME")
fi

if [ -z "$handled_package" ] && [ -z "$handled_downloads" ]; then
    echo "$SCRIPT_NAME: no installer file to remove"
    exit 0
fi

echo "$SCRIPT_NAME: scheduling installer removal for${handled_package:+ $handled_package}${handled_downloads:+ $handled_downloads}"

# Every path below is expanded now, while the installer script runs, so the
# generated file carries no state of its own. \$0 is the one exception: it has
# to stay a runtime reference for the self-delete. Paths are emitted one at a
# time rather than joined into a list, because a list would have to be split
# again on whitespace and a package path may well contain a space.
#
# ~/Downloads carries a "group:everyone deny delete" ACL, which root does not
# reliably get past, so anything inside the console user's home is unlinked in
# that user's own session and only falls back to root if that fails.
write_cleanup_for() {
    target_path="$1"
    [ -n "$target_path" ] || return 0
    [ -f "$target_path" ] || return 0
    echo "if [ -f \"$target_path\" ]; then"
    case "$target_path" in
        "${console_home:-/nonexistent}"/*)
            echo "    /bin/launchctl asuser \"$console_uid\" /usr/bin/sudo -u \"$console_user\" /bin/rm -f \"$target_path\" >/dev/null 2>&1 || \\"
            echo "        /bin/rm -f \"$target_path\" >/dev/null 2>&1"
            ;;
        *)
            echo "    /bin/rm -f \"$target_path\""
            ;;
    esac
    echo "    /usr/bin/logger -t aiquotabar.installer \"removed $target_path\""
    echo "fi"
}

{
    echo '#!/bin/sh'
    echo '#'
    echo '# Generated by the AIQuotaBar installer. Removes the installer package'
    echo '# that was just used, then itself and its launchd job.'
    echo '#'
    echo '# Waits a few seconds so macOS Installer has finished reading the'
    echo '# package and written its log before anything is unlinked.'
    echo 'sleep 3'
    write_cleanup_for "$handled_package"
    write_cleanup_for "$handled_downloads"
    echo "/bin/rm -f \"\$0\" \"$CLEANUP_PLIST\""
    echo "/bin/launchctl bootout \"system/$CLEANUP_LABEL\" >/dev/null 2>&1 || true"
    echo 'exit 0'
} > "$CLEANUP_SCRIPT"
/bin/chmod 755 "$CLEANUP_SCRIPT"
/usr/sbin/chown root:wheel "$CLEANUP_SCRIPT" 2>/dev/null || true

run_cleanup_detached() {
    echo "$SCRIPT_NAME: $1" >&2
    /usr/bin/nohup /bin/sh "$CLEANUP_SCRIPT" >/dev/null 2>&1 &
}

# Staged in a subshell with stderr redirected first, so a redirection failure
# is reported as "could not stage" instead of leaking a raw Permission denied
# into the install log.
if ( 2>/dev/null /bin/cat > "$CLEANUP_PLIST" ) <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$CLEANUP_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>$CLEANUP_SCRIPT</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
PLIST
then
    /bin/chmod 644 "$CLEANUP_PLIST" 2>/dev/null || true
    /usr/sbin/chown root:wheel "$CLEANUP_PLIST" 2>/dev/null || true
    if /bin/launchctl bootstrap system "$CLEANUP_PLIST" 2>/dev/null; then
        # launchd has read the job; the file on disk is no longer needed.
        /bin/rm -f "$CLEANUP_PLIST"
    else
        /bin/rm -f "$CLEANUP_PLIST"
        run_cleanup_detached "could not load the cleanup job with launchd"
    fi
else
    run_cleanup_detached "could not stage the cleanup job"
fi

exit 0
