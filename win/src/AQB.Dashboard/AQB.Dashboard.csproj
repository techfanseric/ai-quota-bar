<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\AQB.Core\AQB.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reuse the macOS app's mobile dashboard PWA assets verbatim. -->
    <Content Include="..\..\..\AIQuotaBar\Resources\MobileDashboard\**\*">
      <Link>mobile-dashboard\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
