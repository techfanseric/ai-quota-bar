<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: Codex invokes this hook on every lifecycle event; a console subsystem
         would flash a window on each call. stdout still works over redirected pipes. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AQB.CodexTasks\AQB.CodexTasks.csproj" />
    <ProjectReference Include="..\AQB.Core\AQB.Core.csproj" />
  </ItemGroup>
</Project>
